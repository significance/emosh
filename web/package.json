{
  "name": "emosh-treats-web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Treats-only web app powered by the emosh Rust treat generator compiled to WebAssembly.",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "wasm": "cd .. && wasm-pack build --target web --out-dir web/src/wasm -- --no-default-features --features wasm",
    "test": "vitest run",
    "test:watch": "vitest",
    "coverage": "vitest run --coverage",
    "build:e2e": "vite build --mode e2e --outDir dist-e2e",
    "e2e": "playwright test --grep-invert @shots",
    "e2e:shots": "playwright test --project=shots"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.65.1",
    "@testing-library/dom": "^10.4.2",
    "@vitest/coverage-v8": "^2.1.9",
    "jsdom": "^25.0.1",
    "vite": "^5.4.0",
    "vitest": "^2.1.9"
  },
  "dependencies": {
    "@capacitor/cli": "^6.1.0",
    "@capacitor/clipboard": "^6.0.0",
    "@capacitor/core": "^6.1.0",
    "qrcode": "^1.5.4"
  }
}
